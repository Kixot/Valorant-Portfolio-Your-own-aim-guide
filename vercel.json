{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "functions": { "api/analyze-rounds.js": { "maxDuration": 60 } },
  "routes": [
    { "src": "/(?:server|tools|tests|docs|node_modules)(?:/.*)?", "status": 404 },
    { "src": "/\\.[^/]*(?:/.*)?", "status": 404 },
    { "src": "/(?:package(?:-lock)?\\.json|Preview\\.cmd|README\\.md)", "status": 404 },
    { "src": "/index\\.html", "status": 308, "headers": { "Location": "/" } },
    { "src": "/(dojo|vod)\\.html", "status": 308, "headers": { "Location": "/$1" } },
    { "src": "/(?:pages/)?training(?:\\.html)?/?", "status": 308, "headers": { "Location": "/dojo" } },
    { "src": "/(dojo|vod)/", "status": 308, "headers": { "Location": "/$1" } },
    { "src": "/(dojo|vod)", "dest": "/$1.html" },
    { "handle": "filesystem" }
  ]
}
